# Optional real Host URL for local development. When unset, the Connect screen
# requires the URL and access token supplied by the Solco app's Mobile settings.
# Example for an Android emulator talking to a Host on this Mac:
# EXPO_PUBLIC_SOLCO_HOST_URL=http://10.0.2.2:8757
EXPO_PUBLIC_SOLCO_HOST_URL=

# Optional real Android OS push (requires a Development/Release build with FCM v1).
# UUID from your Expo EAS project. Register with `eas init` / Expo dashboard.
# EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
# Local Firebase Android client config, NOT the FCM service-account private key.
# Keep the file outside Git; never put a Firebase service-account key in this app.
# SOLCO_GOOGLE_SERVICES_FILE=/absolute/path/to/google-services.json
